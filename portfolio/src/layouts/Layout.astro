---
import "~/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import { siteName, themeColor } from "~/data/config";
import { getLocaleFromUrl, localizePath, stripLocaleFromPathname, t } from "~/i18n";

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const { title = siteName, description = "", noindex = false } = Astro.props;
const assetBase = import.meta.env.BASE_URL;
const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const ogImageUrl = new URL("images/og-image.jpg", new URL(assetBase, siteOrigin)).href;
const faviconHref = `${assetBase}favicon.svg`;
const humansHref = `${assetBase}humans.txt`;
const interFontFaces = (
	[
		["inter-v18-latin-300.woff2", "normal", 300],
		["inter-v18-latin-300italic.woff2", "italic", 300],
		["inter-v18-latin-regular.woff2", "normal", 400],
		["inter-v18-latin-italic.woff2", "italic", 400],
		["inter-v18-latin-500.woff2", "normal", 500],
		["inter-v18-latin-500italic.woff2", "italic", 500],
		["inter-v18-latin-600.woff2", "normal", 600],
		["inter-v18-latin-600italic.woff2", "italic", 600],
		["inter-v18-latin-700.woff2", "normal", 700],
		["inter-v18-latin-700italic.woff2", "italic", 700],
		["inter-v18-latin-900.woff2", "normal", 900],
		["inter-v18-latin-900italic.woff2", "italic", 900],
	] as const
)
	.map(
		([file, style, weight]) =>
			`@font-face{font-display:swap;font-family:"Inter";font-style:${style};font-weight:${weight};src:url('${assetBase}fonts/inter/${file}') format("woff2");}`,
	)
	.join("");
const locale = getLocaleFromUrl(Astro.url);
const htmlLang = locale === "ja" ? "ja" : "en";
const ogLocale = locale === "ja" ? "ja_JP" : "en_US";
const isContactPage = stripLocaleFromPathname(Astro.url.pathname).startsWith("/contact");
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content={themeColor} />
		<meta name="description" content={description} />
		<meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow"} />
		<meta name="googlebot" content={noindex ? "noindex,nofollow" : "index,follow"} />
		<meta name="referrer" content="strict-origin-when-cross-origin" />
		<meta http-equiv="X-Content-Type-Options" content="nosniff" />
		<meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=()" />
		<link rel="author" href={humansHref} />
		<meta name="msapplication-TileColor" content="#ffffff" />
		<link rel="icon" type="image/svg+xml" href={faviconHref} />
		<style is:inline set:html={interFontFaces}></style>

		<meta property="og:url" content={Astro.url} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content={ogLocale} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:url" content={Astro.url} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{isContactPage && (
			<>
				<link rel="preconnect" href="https://challenges.cloudflare.com" />
				<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
			</>
		)}
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
		{!isContactPage && (
			<a
				href={localizePath("/contact", locale)}
				class="fixed bottom-6 right-6 z-50 bg-brand-red text-white p-4 rounded-full shadow-lg shadow-brand-red/30 hover:bg-brand-red/90 transition-all hover:scale-110 flex items-center justify-center group"
				aria-label={t("a11y.contactFab", locale)}
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 group-hover:animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
				</svg>
			</a>
		)}
	</body>
</html>
