---
import { t, defaultLocale, type Locale } from "~/i18n";

interface Props {
	locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const turnstileSiteKey = import.meta.env.TURNSTILE_SITE_KEY ?? "";
// trailingSlash: "always" に合わせて末尾スラッシュ付きで POST する（Vercel の自動 308 redirect 回避）
const contactApiUrl = `${import.meta.env.BASE_URL}api/contact/`;
---

<script is:inline define:vars={{ contactApiUrl }}>
	window.__contactApiUrl = contactApiUrl;

	const initContactTurnstile = () => {
		const container = document.getElementById("contact-turnstile");
		if (!container || container.dataset.rendered === "true") return;
		if (!window.turnstile?.render) {
			window.setTimeout(initContactTurnstile, 80);
			return;
		}

		const widgetId = window.turnstile.render(container, {
			sitekey: container.dataset.sitekey,
			callback: () => {
				window.dispatchEvent(new CustomEvent("turnstile-verified"));
			},
			"expired-callback": () => {
				window.dispatchEvent(new CustomEvent("turnstile-expired"));
			},
			"error-callback": () => {
				window.dispatchEvent(new CustomEvent("turnstile-error"));
			},
		});

		container.dataset.widgetId = String(widgetId);
		container.dataset.rendered = "true";
	};

	document.addEventListener("astro:page-load", initContactTurnstile);
	document.addEventListener("DOMContentLoaded", initContactTurnstile);
</script>

<form
	id="contact-form"
	x-data="{ status: 'idle', cooldown: false, errorCode: '', turnstileVerified: false, contactApiUrl: window.__contactApiUrl }"
	x-on:turnstile-verified.window="turnstileVerified = true"
	x-on:turnstile-expired.window="turnstileVerified = false"
	x-on:turnstile-error.window="turnstileVerified = false"
	x-on:submit.prevent="
		if (cooldown || status === 'sending') return;
		if (!turnstileVerified) {
			status = 'error';
			errorCode = 'turnstile_missing';
			return;
		}
		status = 'sending';
		errorCode = '';
		cooldown = true;
		const form = $el;
		const getValue = (name) => (form.elements.namedItem(name)?.value ?? '').trim();
		const token = getValue('cf-turnstile-response');
		const payload = {
			name: getValue('name'),
			email: getValue('email'),
			inquiryType: getValue('inquiry-type'),
			message: getValue('message'),
			locale: getValue('locale'),
			token,
		};
		console.info('[contact-form] POST', contactApiUrl);
		fetch(contactApiUrl, {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify(payload),
		})
		.then(async (r) => ({ status: r.status, body: await r.json().catch(() => ({ ok: false, error: 'unknown_error' })) }))
		.then(data => {
			if (data.status >= 200 && data.status < 300 && data.body?.ok) {
				status = 'success';
				form.reset();
			} else {
				status = 'error';
				errorCode = data.body?.error || 'unknown_error';
				console.error('[contact-form] bad response', data.status, data.body);
			}
			if (window.turnstile) {
				const widgetId = document.getElementById('contact-turnstile')?.dataset.widgetId;
				if (widgetId) {
					window.turnstile.reset(widgetId);
				}
			}
			turnstileVerified = false;
		})
		.catch((err) => {
			console.error('[contact-form] fetch failed', err);
			status = 'error';
			errorCode = 'unknown_error';
			if (window.turnstile) {
				const widgetId = document.getElementById('contact-turnstile')?.dataset.widgetId;
				if (widgetId) {
					window.turnstile.reset(widgetId);
				}
			}
			turnstileVerified = false;
		})
		.finally(() => { setTimeout(() => { cooldown = false; }, 30000); });
	"
>
	<input type="hidden" name="locale" value={locale} />

	<div x-show="status === 'success'" x-cloak class="rounded-xl bg-brand-green/10 border border-brand-green/30 p-6 text-center text-brand-green font-medium mb-6">
		{t("page.contact.form.success", locale)}
	</div>

	<div x-show="status === 'error'" x-cloak class="rounded-xl bg-brand-red/10 border border-brand-red/30 p-6 text-center text-brand-red font-medium mb-6">
		<p x-show="['invalid_name','invalid_email','invalid_message','invalid_inquiry_type'].includes(errorCode)">
			{t("page.contact.form.error.validation", locale)}
		</p>
		<p x-show="['turnstile_missing','turnstile_failed'].includes(errorCode)">
			{t("page.contact.form.error.turnstile", locale)}
		</p>
		<p x-show="['invalid_request','server_error','send_failed','unknown_error'].includes(errorCode)">
			{t("page.contact.form.error", locale)}
		</p>
	</div>

	<div class="flex flex-col gap-6" x-show="status !== 'success'">
		<div>
			<label for="name">{t("page.contact.form.name", locale)}</label>
			<div class="mt-2">
				<input type="text" name="name" id="name" required />
			</div>
		</div>

		<div>
			<label for="email">{t("page.contact.form.email", locale)}</label>
			<div class="mt-2 grid grid-cols-1">
				<input type="email" name="email" id="email" placeholder={t("page.contact.form.emailPlaceholder", locale)} required />
			</div>
		</div>

		<div>
			<label for="inquiry-type">{t("page.contact.form.inquiryType", locale)}</label>
			<div class="mt-2 text-brand-black">
				<select
					name="inquiry-type"
					id="inquiry-type"
					class="w-full rounded-md border-0 bg-white py-3 px-4 text-brand-black shadow-sm ring-1 ring-inset ring-brand-gray/50 focus:ring-2 focus:ring-inset focus:ring-brand-green sm:text-sm sm:leading-6"
					required
				>
					<option value="" disabled selected>{t("page.contact.form.inquiryPlaceholder", locale)}</option>
					<option value="project">{t("page.contact.form.inquiryProject", locale)}</option>
					<option value="consultation">{t("page.contact.form.inquiryConsultation", locale)}</option>
					<option value="chat">{t("page.contact.form.inquiryChat", locale)}</option>
					<option value="other">{t("page.contact.form.inquiryOther", locale)}</option>
				</select>
			</div>
		</div>

		<div>
			<label for="message">{t("page.contact.form.message", locale)}</label>
			<div class="mt-2">
				<textarea name="message" id="message" rows="4" required></textarea>
			</div>
		</div>

		<div>
			<div
				id="contact-turnstile"
				class="cf-turnstile"
				data-sitekey={turnstileSiteKey}
			></div>
		</div>

		<div>
			<button type="submit" class="button button-green group !px-8" :disabled="status === 'sending' || !turnstileVerified">
				<span x-show="status === 'sending'" class="loader inline-block mr-2"></span>
				<span x-show="status !== 'sending'">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						fill="none"
						viewBox="0 0 24 24"
						stroke-width="1.5"
						stroke="currentColor"
						class="size-5 -rotate-45 -mt-1 inline-block mr-1 group-hover:rotate-0 transition duration-300"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5"
						></path>
					</svg>
				</span>
				<span x-show="status === 'sending'">{t("page.contact.form.sending", locale)}</span>
				<span x-show="status !== 'sending'">{t("page.contact.form.send", locale)}</span>
			</button>
		</div>
	</div>
</form>
