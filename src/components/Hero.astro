---
const hasRight = Astro.slots.has("hero-content-right");
---

<div class:list={["grid grid-cols-1 gap-8 lg:items-center", hasRight && "lg:grid-cols-2"]}>
	<Fragment>
		<slot name="hero-content-left" />
	</Fragment>
	{hasRight && (
		<Fragment>
			<slot name="hero-content-right" />
		</Fragment>
	)}
</div>
