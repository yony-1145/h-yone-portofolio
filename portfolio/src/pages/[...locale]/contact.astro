---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Heading from "~/components/Heading.astro";
import FormContact from "~/components/forms/FormContact.astro";
import { socialMedia, email } from "~/data/config";
import SocialIcon from "~/components/SocialIcon.astro";
import { getLocaleStaticPaths, defaultLocale, t, type Locale } from "~/i18n";

export const getStaticPaths = getLocaleStaticPaths;

const locale = (Astro.params.locale ?? defaultLocale) as Locale;
---

<Layout title={t("page.contact.title", locale)} description={t("page.contact.description", locale)}>
	<Section>
		<Heading>
			<h2 slot="heading-title" class="font-black text-brand-green h2">{t("page.contact.heading", locale)}</h2>
			<p slot="heading-content">{t("page.contact.desc", locale)}</p>
		</Heading>

		<div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16 max-w-5xl mx-auto">
			<div class="lg:col-span-2 flex flex-col gap-8">
				<div>
					<h3 class="font-bold text-lg mb-2">{t("page.contact.form.email", locale)}</h3>
					<a href={email.href} class="text-brand-green hover:underline font-medium">{email.label}</a>
				</div>
				<div>
					<h3 class="font-bold text-lg mb-4">SNS</h3>
					<div class="flex gap-5">
						{Object.values(socialMedia).map((social) => (
							<a
								href={social.url}
								target="_blank"
								rel="noopener noreferrer"
								class="text-brand-gray hover:text-brand-green transition-colors"
								aria-label={social.label}
							>
								<SocialIcon platform={social.platform} />
							</a>
						))}
					</div>
				</div>
			</div>

			<div class="lg:col-span-3">
				<FormContact locale={locale} />
			</div>
		</div>
	</Section>
</Layout>
