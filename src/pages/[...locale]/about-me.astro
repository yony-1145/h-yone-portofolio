---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Heading from "~/components/Heading.astro";
import Timeline from "~/components/Timeline.astro";
import { Picture } from "astro:assets";
import Badge from "~/components/Badge.astro";
import Button from "~/components/Button.astro";
import { getLocaleStaticPaths, defaultLocale, localizePath, t, type Locale } from "~/i18n";

import ProfilePlaceholder from "~/assets/images/profile-placeholder.png";

export const getStaticPaths = getLocaleStaticPaths;

const locale = (Astro.params.locale ?? defaultLocale) as Locale;

const timelineItems = [
	{
		period: t("page.about.timeline.1.period", locale),
		title: t("page.about.timeline.1.title", locale),
		subtitle: t("page.about.timeline.1.subtitle", locale),
		desc: t("page.about.timeline.1.desc", locale),
		tags: t("page.about.timeline.1.tags", locale).split(","),
		current: true,
		links: [
			{ label: t("page.about.timeline.1.link1", locale), url: "https://www.101hakatamingle.com/", external: true },
		],
	},
	{
		period: t("page.about.timeline.2.period", locale),
		title: t("page.about.timeline.2.title", locale),
		subtitle: t("page.about.timeline.2.subtitle", locale),
		desc: t("page.about.timeline.2.desc", locale),
		tags: t("page.about.timeline.2.tags", locale).split(","),
		current: true,
		links: [
			{ label: t("page.about.timeline.2.link1", locale), url: "https://github.com/yony-1145", external: true },
		],
	},
	{
		period: t("page.about.timeline.3.period", locale),
		title: t("page.about.timeline.3.title", locale),
		subtitle: t("page.about.timeline.3.subtitle", locale),
		desc: t("page.about.timeline.3.desc", locale),
		tags: t("page.about.timeline.3.tags", locale).split(","),
		current: true,
	},
];
---

<Layout title={t("page.about.title", locale)} description={t("page.about.description", locale)}>
	<Section class:list={"bg-white"}>
		<div class="flex flex-col items-center text-center max-w-2xl mx-auto">
			<Picture
				class:list={"rounded-full shadow-xl w-40 h-40 object-cover mb-8"}
				src={ProfilePlaceholder}
				width={160}
				height={160}
				formats={["avif", "webp"]}
				alt={t("page.about.hero.profileImageAlt", locale)}
				loading={"eager"}
				fetchpriority={"high"}
			/>
			<Badge title={t("page.about.hero.badge", locale)} />
			<h1 class="font-black mt-4">{t("page.about.hero.heading", locale)}</h1>
			<p class="text-lg leading-relaxed text-gray-600 whitespace-pre-line mt-4">{t("page.about.hero.desc", locale)}</p>
			<span class="text-brand-green font-medium mt-4">{t("page.about.hero.available", locale)}</span>
			<div class="mt-8">
				<Button url={localizePath("/contact", locale)}>{t("cta.getInTouch", locale)}</Button>
			</div>
		</div>
	</Section>

	<Section class:list={"bg-gray-50"}>
		<Heading>
			<h2 slot="heading-title" class="font-black text-brand-green h2">{t("page.about.aboutme.heading", locale)}</h2>
		</Heading>
		<div class="max-w-2xl mx-auto">
			<p class="text-lg leading-relaxed text-gray-600 whitespace-pre-line text-center">{t("page.about.aboutme.body", locale)}</p>
			<div class="mt-8 text-center">
				<Button url={localizePath("/contact", locale)}>{t("cta.getInTouch", locale)}</Button>
			</div>
		</div>
	</Section>

	<Section class:list={"bg-white"}>
		<Heading>
			<h2 slot="heading-title" class="font-black text-brand-green h2">{t("page.about.timeline.heading", locale)}</h2>
			<p slot="heading-content">{t("page.about.timeline.desc", locale)}</p>
		</Heading>
		<div class="max-w-3xl mx-auto">
			<Timeline items={timelineItems} />
		</div>
	</Section>
</Layout>
