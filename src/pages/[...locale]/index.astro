---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Hero from "~/components/Hero.astro";
import { Picture } from "astro:assets";
import Badge from "~/components/Badge.astro";
import Button from "~/components/Button.astro";
import Grid from "~/components/Grid.astro";
import Heading from "~/components/Heading.astro";
import { getLocaleStaticPaths, defaultLocale, localizePath, t, type Locale } from "~/i18n";

import ProfilePlaceholder from "~/assets/images/profile-placeholder.png";
import ProjectCoworkerImage from "~/assets/images/projects/coworker.png";
import ProjectHakatamingleImage from "~/assets/images/projects/hakatamingle.png";

export const getStaticPaths = getLocaleStaticPaths;

const locale = (Astro.params.locale ?? defaultLocale) as Locale;

const testimonialAriaKeys = [
	"page.index.testimonials.aria.1",
	"page.index.testimonials.aria.2",
	"page.index.testimonials.aria.3",
] as const;
---

<Layout title={t("page.index.title", locale)} description={t("page.index.description", locale)}>
	<Section class:list={"bg-white"}>
		<Hero>
			<div slot="hero-content-left" class="prose max-w-none max-lg:order-1">
				<Badge title={t("page.index.hero.badge", locale)} />
				<h1 class="font-black">{t("page.index.hero.heading", locale)}</h1>
				<p class="whitespace-pre-line">{t("page.index.hero.desc", locale)}</p>
				<span class="text-brand-green font-medium">{t("page.index.hero.available", locale)}</span>
				<div class="mt-8 flex items-center gap-x-8">
					<Button url={localizePath("/contact", locale)}>{t("cta.contact", locale)}</Button>
				</div>
			</div>
			<div slot="hero-content-right">
				<Picture
					class:list={"mx-auto w-full max-w-[480px] h-auto rounded-2xl shadow-xl"}
					src={ProfilePlaceholder}
					width={480}
					height={600}
					sizes="(min-width: 1024px) min(480px, 50vw), 100vw"
					densities={[1]}
					formats={["avif", "webp"]}
					alt={t("page.index.hero.profileImageAlt", locale)}
					loading={"eager"}
					fetchpriority={"high"}
				/>
			</div>
		</Hero>
	</Section>

	<Section class:list={"bg-gray-50"} id="skills">
		<Heading>
			<h2 slot="heading-title" class="font-black text-brand-green h2">{t("page.index.skills.heading", locale)}</h2>
			<p slot="heading-content">{t("page.index.skills.desc", locale)}</p>
		</Heading>

		<Grid>
			<div class="flex flex-col items-center prose text-center bg-white rounded-2xl border border-gray-100 shadow-md hover:shadow-xl transition-shadow duration-300 p-8 h-full">
				<div class="w-24 h-24 mb-4 bg-brand-green/10 text-brand-green rounded-full flex items-center justify-center">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
				</div>
				<h3 class="h4 mt-0 font-black">{t("page.index.skills.frontend.title", locale)}</h3>
				<p>{t("page.index.skills.frontend.desc", locale)}</p>
			</div>

			<div class="flex flex-col items-center prose text-center bg-white rounded-2xl border border-gray-100 shadow-md hover:shadow-xl transition-shadow duration-300 p-8 h-full">
				<div class="w-24 h-24 mb-4 bg-brand-green/10 text-brand-green rounded-full flex items-center justify-center">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" /></svg>
				</div>
				<h3 class="h4 mt-0 font-black">{t("page.index.skills.backend.title", locale)}</h3>
				<p>{t("page.index.skills.backend.desc", locale)}</p>
			</div>

			<div class="flex flex-col items-center prose text-center bg-white rounded-2xl border border-gray-100 shadow-md hover:shadow-xl transition-shadow duration-300 p-8 h-full">
				<div class="w-24 h-24 mb-4 bg-brand-green/10 text-brand-green rounded-full flex items-center justify-center">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
				</div>
				<h3 class="h4 mt-0 font-black">{t("page.index.skills.devops.title", locale)}</h3>
				<p>{t("page.index.skills.devops.desc", locale)}</p>
			</div>
		</Grid>
	</Section>

	<Section class:list={"bg-white"} id="projects">
		<Heading>
			<h2 slot="heading-title" class="font-black text-brand-green h2">{t("page.index.projects.heading", locale)}</h2>
			<p slot="heading-content">{t("page.index.projects.desc", locale)}</p>
		</Heading>

		<Hero>
			<div slot="hero-content-left" class="prose lg:order-2">
				<Badge title={t("page.index.projects.coworker.badge", locale)} />
				<h3 class="font-black h2 mt-4">{t("page.index.projects.coworker.title", locale)}</h3>
				<p>{t("page.index.projects.coworker.desc1", locale)}</p>
				<p>{t("page.index.projects.coworker.desc2", locale)}</p>
				<div class="mt-6 flex items-center gap-6">
					<a href="https://coworker-pi.vercel.app/" target="_blank" rel="noopener noreferrer" class="font-bold text-brand-green hover:underline flex items-center gap-1">
						{t("page.index.projects.coworker.liveDemo", locale)}
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
					</a>
					<a href="https://github.com/yony-1145/coworker" target="_blank" rel="noopener noreferrer" class="font-bold text-brand-gray hover:text-brand-green hover:underline flex items-center gap-1">
						{t("page.index.projects.coworker.sourceCode", locale)}
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
					</a>
				</div>
			</div>
			<div slot="hero-content-right">
				<Picture
					class:list={"w-full rounded-2xl shadow-lg"}
					src={ProjectCoworkerImage}
					width={1200}
					height={800}
					sizes="(min-width: 1024px) 50vw, 100vw"
					densities={[1]}
					formats={["avif", "webp"]}
					alt={t("page.index.projects.coworker.imageAlt", locale)}
					loading={"lazy"}
				/>
			</div>
		</Hero>
	</Section>

	<Section class:list={"bg-gray-50"} id="project-hakatamingle">
		<Hero>
			<div slot="hero-content-left" class="prose">
				<Badge color="red" title={t("page.index.projects.hakatamingle.badge", locale)} />
				<h3 class="font-black h2 mt-4">{t("page.index.projects.hakatamingle.title", locale)}</h3>
				<p>{t("page.index.projects.hakatamingle.desc1", locale)}</p>
				<p>{t("page.index.projects.hakatamingle.desc2", locale)}</p>
				<div class="mt-6 flex items-center gap-6">
					<a href="https://www.101hakatamingle.com/" target="_blank" rel="noopener noreferrer" class="font-bold text-brand-green hover:underline flex items-center gap-1">
						{t("page.index.projects.hakatamingle.visitSite", locale)}
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
					</a>
				</div>
			</div>
			<div slot="hero-content-right">
				<Picture
					class:list={"w-full rounded-2xl shadow-lg"}
					src={ProjectHakatamingleImage}
					width={1200}
					height={800}
					sizes="(min-width: 1024px) 50vw, 100vw"
					densities={[1]}
					formats={["avif", "webp"]}
					alt={t("page.index.projects.hakatamingle.imageAlt", locale)}
					loading={"lazy"}
				/>
			</div>
		</Hero>
	</Section>

	<Section class:list={"bg-white"} id="testimonials">
		<Heading>
			<h2 slot="heading-title" class="font-black text-brand-red h2">{t("page.index.testimonials.heading", locale)}</h2>
			<p slot="heading-content">{t("page.index.testimonials.desc", locale)}</p>
		</Heading>

		<div
			x-data="{
				current: 0,
				total: 3,
				autoplay: null,
				init() {
					this.startAutoplay();
				},
				startAutoplay() {
					this.autoplay = setInterval(() => { this.next() }, 7000);
				},
				stopAutoplay() {
					clearInterval(this.autoplay);
				},
				next() {
					this.current = (this.current + 1) % this.total;
				},
				goTo(index) {
					this.current = index;
					this.stopAutoplay();
					this.startAutoplay();
				}
			}"
			class="relative max-w-3xl mx-auto"
			@mouseenter="stopAutoplay()"
			@mouseleave="startAutoplay()"
		>
			<div class="bg-white rounded-2xl border border-gray-100 shadow-md p-8 lg:p-12">
				<div class="relative min-h-[200px]">
					{[
						{ quote: t("page.index.testimonials.1.quote", locale), author: t("page.index.testimonials.1.author", locale), role: t("page.index.testimonials.1.role", locale) },
						{ quote: t("page.index.testimonials.2.quote", locale), author: t("page.index.testimonials.2.author", locale), role: t("page.index.testimonials.2.role", locale) },
						{ quote: t("page.index.testimonials.3.quote", locale), author: t("page.index.testimonials.3.author", locale), role: t("page.index.testimonials.3.role", locale) },
					].map((item, idx) => (
						<div
							x-show={`current === ${idx}`}
							x-transition:enter="transition ease-out duration-300"
							x-transition:enter-start="opacity-0 translate-x-8"
							x-transition:enter-end="opacity-100 translate-x-0"
							x-transition:leave="transition ease-in duration-200"
							x-transition:leave-start="opacity-100"
							x-transition:leave-end="opacity-0 -translate-x-8"
							class="absolute inset-0"
						>
							<blockquote class="text-center">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-brand-red/30 mx-auto mb-4" fill="currentColor" viewBox="0 0 24 24"><path d="M11.3 2.8C6.1 5.1 3 9.2 3 14c0 3.3 2.4 6 5.4 6 2.8 0 4.6-2 4.6-4.4 0-2.4-1.7-4.2-4-4.2-.4 0-.9.1-1.2.2.4-2.6 2.5-5.4 5.4-7L11.3 2.8zm10 0C16.1 5.1 13 9.2 13 14c0 3.3 2.4 6 5.4 6 2.8 0 4.6-2 4.6-4.4 0-2.4-1.7-4.2-4-4.2-.4 0-.9.1-1.2.2.4-2.6 2.5-5.4 5.4-7L21.3 2.8z"/></svg>
								<p class="font-medium text-xl lg:text-2xl text-balance leading-relaxed">{item.quote}</p>
								<footer class="mt-6 pt-4 border-t border-gray-100">
									<span class="font-bold text-brand-red block">{item.author}</span>
									<cite class="text-gray-500 not-italic text-sm">{item.role}</cite>
								</footer>
							</blockquote>
						</div>
					))}
				</div>
			</div>

			<div class="flex justify-center gap-2 mt-4">
				{[0, 1, 2].map((idx) => (
					<button
						x-on:click={`goTo(${idx})`}
						class="w-3 h-3 rounded-full transition-colors duration-200"
						x-bind:class={`current === ${idx} ? 'bg-brand-red' : 'bg-gray-300 hover:bg-gray-400'`}
						aria-label={t(testimonialAriaKeys[idx], locale)}
					/>
				))}
			</div>
		</div>
	</Section>

	<Section class:list={"bg-brand-green"}>
		<div class="max-w-3xl mx-auto text-center prose">
			<h2 class="font-black text-white h2 !mb-6 !mt-0">{t("page.index.cta.heading", locale)}</h2>
			<p class="text-white/90">{t("page.index.cta.desc", locale)}</p>
			<div class="mt-8">
				<Button color="red" url={localizePath("/contact", locale)}>{t("cta.contact", locale)}</Button>
			</div>
		</div>
	</Section>
</Layout>
