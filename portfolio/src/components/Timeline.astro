---
interface TimelineLink {
	label: string;
	url: string;
	external?: boolean;
}

interface TimelineItem {
	period: string;
	title: string;
	subtitle?: string;
	desc: string;
	tags?: string[];
	links?: TimelineLink[];
	current?: boolean;
}

interface Props {
	items: TimelineItem[];
}

const { items } = Astro.props;
---

<ol class="relative border-l-2 border-brand-green/30 ml-4 lg:ml-0">
	{items.map((item) => (
		<li class="mb-12 last:mb-0 ml-8 lg:ml-10">
			<span
				class:list={[
					"absolute -left-[9px] flex items-center justify-center rounded-full border-2 border-brand-green",
					item.current
						? "w-4 h-4 bg-brand-green ring-4 ring-brand-green/20"
						: "w-4 h-4 bg-white",
				]}
			/>

			<time class="mb-2 block text-sm font-semibold text-brand-green">
				{item.period}
			</time>

			<h3 class="text-xl font-black text-gray-700 lg:text-2xl">
				{item.title}
			</h3>

			{item.subtitle && (
				<p class="mt-1 text-base font-medium text-gray-500">
					{item.subtitle}
				</p>
			)}

			<p class="mt-3 text-lg leading-relaxed text-gray-600">
				{item.desc}
			</p>

			{item.tags && item.tags.length > 0 && (
				<div class="mt-4 flex flex-wrap gap-2">
					{item.tags.map((tag) => (
						<span class="rounded-full bg-brand-green/10 px-3 py-1 text-xs font-semibold text-brand-green">
							{tag}
						</span>
					))}
				</div>
			)}

			{item.links && item.links.length > 0 && (
				<div class="mt-4 flex flex-wrap items-center gap-4">
					{item.links.map((link) => (
						<a
							href={link.url}
							target={link.external ? "_blank" : undefined}
							rel={link.external ? "noopener noreferrer" : undefined}
							class="inline-flex items-center gap-1 text-sm font-bold text-brand-green hover:underline"
						>
							{link.label}
							{link.external && (
								<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
							)}
						</a>
					))}
				</div>
			)}
		</li>
	))}
</ol>
